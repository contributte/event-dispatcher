<?php
/** @var EventTrace[] $events */
/** @var int $handledCount */
/** @var int $failedCount */
/** @var float $totalTime */
/** @var int|null $deep */

use Contributte\EventDispatcher\Diagnostics\EventTrace;
use Tracy\Dumper;

$dumperOptions = [Dumper::COLLAPSE => true];
if ($deep !== null) {
	$dumperOptions[Dumper::DEPTH] = $deep;
}
?>
<style>
	#tracy-debug .event-name, #tracy-debug .listener-name {
		font-weight: bold;
	}

	#tracy-debug .event-class,
	#tracy-debug .event-meta,
	#tracy-debug .muted {
		color: #666;
		font-size: 12px;
	}

	#tracy-debug .listener-row + .listener-row {
		margin-top: 6px;
	}

	#tracy-debug .exception {
		margin-top: 4px;
		color: #b00020;
	}

	#tracy-debug ul.event-listeners {
		margin: 0;
		padding-left: 16px;
	}
</style>

<?php if ($handledCount === 0): ?>
	<h1>No events handled</h1>
<?php else: ?>
	<h1>
		Events: <?= $handledCount ?>
		<?php if ($failedCount > 0): ?>
			/ failed: <?= $failedCount ?>
		<?php endif; ?>
		, time: <?= sprintf('%0.3f', $totalTime * 1000) ?> ms
	</h1>
<?php endif; ?>

<div class="tracy-inner">
	<div class="tracy-inner-container">
		<?php if ($events !== []): ?>
			<table class="tracy-sortable">
				<tr>
					<th>Time&nbsp;ms</th>
					<th>Handled</th>
					<th>Event</th>
					<th>Listeners</th>
				</tr>

				<?php foreach ($events as $e): ?>
					<tr>
						<td>
							<?= sprintf('%0.2f', $e->duration * 1000); ?>
						</td>
						<td>
							<?= $e->handled ? 'yes' : 'no' ?>
							<div class="event-meta">
								<?= $e->listenerCount ?> listeners
								<?php if ($e->propagationStopped): ?>
									, stopped
								<?php endif; ?>
								<?php if ($e->exception !== null): ?>
									, failed
								<?php endif; ?>
							</div>
							<?php if ($e->exception !== null): ?>
								<div class="exception">
									<?= htmlspecialchars(get_class($e->exception) . ': ' . $e->exception->getMessage(), ENT_QUOTES, 'UTF-8') ?>
								</div>
							<?php endif; ?>
						</td>
						<td>
							<code class="event-name"><?= htmlspecialchars($e->name, ENT_QUOTES, 'UTF-8') ?></code>
							<?php if ($e->name !== $e->eventClass): ?>
								<div class="event-class"><?= htmlspecialchars($e->eventClass, ENT_QUOTES, 'UTF-8') ?></div>
							<?php endif; ?>
							<?= Dumper::toHtml($e->event, $dumperOptions); ?>
						</td>
						<td>
							<?php if ($e->listeners === []): ?>
								<span class="muted">No listeners</span>
							<?php else: ?>
								<ul class="event-listeners">
									<?php foreach ($e->listeners as $listener): ?>
										<li><code class="listener-name"><?= htmlspecialchars($listener['listener'], ENT_QUOTES, 'UTF-8') ?></code> (priority <?= $listener['priority'] ?>)</li>
									<?php endforeach; ?>
								</ul>
							<?php endif; ?>
						</td>
					</tr>
				<?php endforeach; ?>
			</table>
		<?php else: ?>
			<p class="muted">No events dispatched yet.</p>
		<?php endif; ?>
	</div>
</div>
